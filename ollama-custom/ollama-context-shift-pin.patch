 func resolveContextShift(shift *bool, m *Model) bool {
+	// OLLAMA_CONTEXT_SHIFT pins context shift as a server-wide launch attribute.
+	// Without it, clients that disagree on the request-level shift option force
+	// a full runner reload on every alternating request.
+	if raw := strings.TrimSpace(envconfig.Var("OLLAMA_CONTEXT_SHIFT")); raw != "" {
+		if forced, err := strconv.ParseBool(raw); err == nil {
+			return forced && supportsContextShift(m)
+		}
+		slog.Warn("invalid OLLAMA_CONTEXT_SHIFT, using request shift option", "value", raw)
+	}
+
 	if shift != nil {
 		return *shift
 	}
