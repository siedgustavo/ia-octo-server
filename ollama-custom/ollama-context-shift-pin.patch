+func TestResolveContextShiftServerOverride(t *testing.T) {
+	trueValue := true
+	falseValue := false
+	deepseek := &Model{Config: model.ConfigV2{ModelFamily: "deepseek2"}}
+
+	t.Setenv("OLLAMA_CONTEXT_SHIFT", "true")
+	require.True(t, resolveContextShift(nil, nil))
+	require.True(t, resolveContextShift(&falseValue, nil))
+	require.False(t, resolveContextShift(&trueValue, deepseek))
+
+	t.Setenv("OLLAMA_CONTEXT_SHIFT", "false")
+	require.False(t, resolveContextShift(nil, nil))
+	require.False(t, resolveContextShift(&trueValue, nil))
+
+	t.Setenv("OLLAMA_CONTEXT_SHIFT", "bogus")
+	require.False(t, resolveContextShift(&falseValue, nil))
+	require.True(t, resolveContextShift(nil, nil))
+}
+
+func TestSchedNeedsReloadIgnoresClientShiftWhenServerPinsContextShift(t *testing.T) {
+	ctx, done := context.WithTimeout(t.Context(), 100*time.Millisecond)
+	defer done()
+
+	falseValue := false
+	llm := &mockLlm{vramByGPU: map[ml.DeviceID]uint64{}}
+	opts := api.DefaultOptions()
+	model := &Model{ModelPath: "model.gguf"}
+	runner := &runnerRef{
+		model:        model,
+		Options:      &opts,
+		llama:        llm,
+		numParallel:  1,
+		contextShift: true,
+	}
+	req := &LlmRequest{
+		model: model,
+		opts:  api.DefaultOptions(),
+		shift: &falseValue,
+	}
+
+	require.True(t, runner.needsReload(ctx, req))
+
+	t.Setenv("OLLAMA_CONTEXT_SHIFT", "true")
+	require.False(t, runner.needsReload(ctx, req))
+}
