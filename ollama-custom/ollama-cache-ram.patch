+func TestAppendCacheRAMArgs(t *testing.T) {
+	tests := []struct {
+		raw  string
+		want []string
+	}{
+		{raw: "", want: []string{"base"}},
+		{raw: "32768", want: []string{"base", "--cache-ram", "32768"}},
+		{raw: " 16384 ", want: []string{"base", "--cache-ram", "16384"}},
+		{raw: "0", want: []string{"base", "--cache-ram", "0"}},
+		{raw: "-1", want: []string{"base", "--cache-ram", "-1"}},
+		{raw: "-2", want: []string{"base"}},
+		{raw: "32GiB", want: []string{"base"}},
+	}
+
+	for _, tt := range tests {
+		t.Run(tt.raw, func(t *testing.T) {
+			got := appendCacheRAMArgs([]string{"base"}, tt.raw)
+			if !slices.Equal(got, tt.want) {
+				t.Fatalf("appendCacheRAMArgs(%q) = %v, want %v", tt.raw, got, tt.want)
+			}
+		})
+	}
+}
