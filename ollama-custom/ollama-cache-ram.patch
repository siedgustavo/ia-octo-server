+// appendCacheRAMArgs passes OLLAMA_CACHE_RAM_MIB to llama-server --cache-ram.
+// It sizes the host-RAM prompt cache that keeps idle conversations restorable
+// when a single slot alternates between clients. Unset keeps llama.cpp's
+// default (8192 MiB); -1 means unlimited and 0 disables the cache.
+func appendCacheRAMArgs(params []string, raw string) []string {
+	raw = strings.TrimSpace(raw)
+	if raw == "" {
+		return params
+	}
+
+	mib, err := strconv.Atoi(raw)
+	if err != nil || mib < -1 {
+		slog.Warn("invalid OLLAMA_CACHE_RAM_MIB, using llama-server default", "value", raw)
+		return params
+	}
+
+	return append(params, "--cache-ram", strconv.Itoa(mib))
+}
