# Set to 1 to run without Octofan USB hardware.
OCTOFAN_MOCK=0

# Published host ports.
OCTOFAN_CONTROLLER_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
OLLAMA_PORT=11434

# Docker network shared with an external Ollama container.
OCTOFAN_DOCKER_NETWORK=octofan-ai

# Override if you want to pin a specific Ollama image.
OLLAMA_IMAGE=ollama/ollama:latest
