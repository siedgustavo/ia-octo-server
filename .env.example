# Set to 1 to run without Octofan USB hardware.
OCTOFAN_MOCK=0
OCTOFAN_DISPLAY_IP=

# Published host ports.
OCTOFAN_CONTROLLER_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
LLAMA31_PRO_PORT=8082
PERMISSION_CLASSIFIER_PORT=8083

# Prometheus local history limits. The first limit reached wins.
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB

# Docker network for the controller, monitoring and llama.cpp servers.
OCTOFAN_DOCKER_NETWORK=octofan-ai

# Local GGUF model directory mounted read-only into llama.cpp containers.
MODELS_DIR=/opt/llamacpp/models

LLAMA31_PRO_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA31_PRO_ALIAS=llama3.1:8b
LLAMA31_PRO_MODEL=Llama-3.1-Pro-Coder-v1.Q4_K_M.gguf
LLAMA31_PRO_CTX_SIZE=131072
LLAMA31_PRO_N_GPU_LAYERS=999
LLAMA31_PRO_PARALLEL=1
LLAMA31_PRO_BATCH_SIZE=512
LLAMA31_PRO_UBATCH_SIZE=128
LLAMA31_PRO_CACHE_TYPE=q4_0
LLAMA31_PRO_GPU=2

PERMISSION_CLASSIFIER_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
PERMISSION_CLASSIFIER_ALIAS=qwen2.5-coder:7b
PERMISSION_CLASSIFIER_MODEL=Qwen2.5-Coder-7B-Instruct-Q4_K_M.gguf
PERMISSION_CLASSIFIER_CTX_SIZE=131072
PERMISSION_CLASSIFIER_N_GPU_LAYERS=999
PERMISSION_CLASSIFIER_PARALLEL=1
PERMISSION_CLASSIFIER_BATCH_SIZE=512
PERMISSION_CLASSIFIER_UBATCH_SIZE=128
PERMISSION_CLASSIFIER_CACHE_TYPE=q8_0
PERMISSION_CLASSIFIER_GPU=3

# Optional DeepSeek V4 Flash 0731 service (docker compose --profile deepseek-v4 ...).
DEEPSEEK_V4_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
DEEPSEEK_V4_PORT=8084
DEEPSEEK_V4_ALIAS=deepseek-v4-flash:304b
DEEPSEEK_V4_MODEL=deepseek-v4-flash-0731/DeepSeek-V4-Flash-0731-UD-IQ2_M-00001-of-00003.gguf
DEEPSEEK_V4_CTX_SIZE=1048576
DEEPSEEK_V4_THREADS=6
DEEPSEEK_V4_THREADS_BATCH=6
DEEPSEEK_V4_BATCH_SIZE=512
DEEPSEEK_V4_UBATCH_SIZE=128
DEEPSEEK_V4_CACHE_TYPE_K=f16
DEEPSEEK_V4_CACHE_TYPE_V=f16
DEEPSEEK_V4_GPU_0=0
DEEPSEEK_V4_GPU_1=1

OLLAMA_IMAGE=octofan/ollama:0.32.5-vram
OLLAMA_PORT=11434
OLLAMA_DATA_DIR=/opt/ollama
OLLAMA_KEEP_ALIVE=-1
OLLAMA_KV_CACHE_TYPE=q4_0
OLLAMA_NUM_PARALLEL=1
OLLAMA_GPU_0=0
OLLAMA_GPU_1=1

COMFYUI_IMAGE=yanwk/comfyui-boot:cu126-slim
COMFYUI_PORT=8188
COMFYUI_GPU=1
COMFYUI_CLI_ARGS=--listen 0.0.0.0 --port 8188 --lowvram
COMFYUI_CACHE_DIR=/opt/imagegen/comfyui/cache
COMFYUI_CONFIG_DIR=/opt/imagegen/comfyui/config
COMFYUI_LOCAL_DIR=/opt/imagegen/comfyui/local
COMFYUI_CUSTOM_NODES_DIR=/opt/imagegen/comfyui/custom_nodes
COMFYUI_MODELS_DIR=/opt/imagegen/comfyui/models
COMFYUI_INPUT_DIR=/opt/imagegen/comfyui/input
COMFYUI_OUTPUT_DIR=/opt/imagegen/comfyui/output
COMFYUI_USER_DIR=/opt/imagegen/comfyui/user
