# Set to 1 to run without Octofan USB hardware.
OCTOFAN_MOCK=0

# Published host ports.
OCTOFAN_CONTROLLER_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
QWEN3CODER_PORT=8080
QWEN36_UNCENSORED_PORT=8081
LLAMA31_PRO_PORT=8082

# Prometheus local history limits. The first limit reached wins.
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB

# Docker network for the controller, monitoring and llama.cpp servers.
OCTOFAN_DOCKER_NETWORK=octofan-ai

# Local GGUF model directory mounted read-only into llama.cpp containers.
MODELS_DIR=/opt/llamacpp/models

QWEN3CODER_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
QWEN3CODER_ALIAS=qwen3coder:30b
QWEN3CODER_MODEL=Huihui-Qwen3-Coder-30B-A3B-Instruct-abliterated.i1-IQ4_XS.gguf
QWEN3CODER_CTX_SIZE=65536
QWEN3CODER_N_GPU_LAYERS=999
QWEN3CODER_PARALLEL=1
QWEN3CODER_BATCH_SIZE=512
QWEN3CODER_UBATCH_SIZE=128
QWEN3CODER_GPU=0

QWEN36_UNCENSORED_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
QWEN36_UNCENSORED_ALIAS=qwen3.6:35b
QWEN36_UNCENSORED_MODEL=qwen3.6-uncensored.gguf
QWEN36_UNCENSORED_CTX_SIZE=65536
QWEN36_UNCENSORED_N_GPU_LAYERS=999
QWEN36_UNCENSORED_PARALLEL=1
QWEN36_UNCENSORED_BATCH_SIZE=512
QWEN36_UNCENSORED_UBATCH_SIZE=128
QWEN36_UNCENSORED_GPU=1

LLAMA31_PRO_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
LLAMA31_PRO_ALIAS=llama3.1:8b
LLAMA31_PRO_MODEL=llama31-pro.gguf
LLAMA31_PRO_CTX_SIZE=8192
LLAMA31_PRO_N_GPU_LAYERS=999
LLAMA31_PRO_PARALLEL=1
LLAMA31_PRO_BATCH_SIZE=512
LLAMA31_PRO_UBATCH_SIZE=128
LLAMA31_PRO_GPU=2
