# Set to 1 to run without Octofan USB hardware.
OCTOFAN_MOCK=0
# Host IP shown on the OLED "ai" profile. Leave empty to auto-detect from
# the host hostname and /etc/hosts; set it to pin a specific address.
OCTOFAN_DISPLAY_IP=

# Published host ports.
OCTOFAN_CONTROLLER_PORT=8000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
OLLAMA_PORT=11434

# Prometheus local history limits. The first limit reached wins.
PROMETHEUS_RETENTION_TIME=15d
PROMETHEUS_RETENTION_SIZE=2GB

# Docker network shared by the controller, monitoring and Ollama.
OCTOFAN_DOCKER_NETWORK=octofan-ai

# Local GGUF model directories mounted read-only into Ollama.
MODELS_DIR=/opt/llamacpp/models
MODELS_ARCHIVE_DIR=/opt/models-archive

# Ollama runtime.
OLLAMA_IMAGE=octofan/ollama:0.32.13-vram
OLLAMA_DATA_DIR=/opt/ollama
OLLAMA_DNS=172.16.1.1
OLLAMA_KEEP_ALIVE=3h
OLLAMA_KV_CACHE_TYPE=q4_0
OLLAMA_NUM_PARALLEL=1
OLLAMA_SCHED_SPREAD=false
